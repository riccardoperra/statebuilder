  },
  "repository": {
    "type": "git",
    "url": "https://github.com/riccardoperra/statebuilder"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "prettier": "^3.10.1",
